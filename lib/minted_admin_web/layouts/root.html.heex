<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="MINTED - ADMIN">{assigns[:page_title]}</.live_title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64," />
    <link rel="preload" href="/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
    <link phx-track-static rel="stylesheet" href="/assets/blueprint.css" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script phx-track-static defer src={~p"/assets/app.js"}></script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
