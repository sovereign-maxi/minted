<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="MINTED">{assigns[:page_title]}</.live_title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64," />
    <link rel="preload" href="/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
    <link phx-track-static rel="stylesheet" href="/assets/blueprint.css" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script phx-track-static defer src={~p"/assets/app.js"}></script>
  </head>
  <body>
    <%!--
      First-visit welcome / phishing-defense modal. Rendered
      server-side only when the session has not yet been marked
      welcomed. CONTINUE is a plain HTML form that POSTs to the
      WelcomeController — no JavaScript required, works in Tor
      Browser safest-mode where JS is disabled by default.
    --%>
    <div
      :if={not MintedWeb.WelcomeController.welcomed?(@conn)}
      id="welcome-modal-title"
      class="bp-modal-overlay"
      role="dialog"
      aria-modal="true"
      aria-label={MintedWeb.Messages.modal_title_welcome()}
    >
      <div class="bp-modal">
        <.panel title={MintedWeb.Messages.modal_title_welcome()}>
          <.panel_body>
            <div class="mt-welcome">
              <p>{MintedWeb.Messages.welcome_on_host_prefix()}</p>
              <code>{@conn.host}</code>
              <p>{MintedWeb.Messages.welcome_verify_instruction()}</p>
              <p>{MintedWeb.Messages.welcome_description()}</p>
              <form method="post" action={~p"/welcome/dismiss"} class="bp-modal-actions">
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <input type="hidden" name="redirect_to" value={@conn.request_path} />
                <button type="submit" class="bp-btn bp-btn-primary">
                  {MintedWeb.Messages.action_continue()}
                </button>
              </form>
            </div>
          </.panel_body>
        </.panel>
      </div>
    </div>

    {@inner_content}
  </body>
</html>
