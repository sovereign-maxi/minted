# Minted - Tor Hidden Service Configuration
# Auto-generated by Minted.Tor.Config — do not edit manually

SocksPort <%= @socks_port %>
ControlPort <%= @control_port %>

# User API hidden service
HiddenServiceDir <%= @user_dir %>
HiddenServicePort 443 127.0.0.1:<%= @user_port %>

# Admin hidden service
HiddenServiceDir <%= @admin_dir %>
HiddenServicePort 443 127.0.0.1:<%= @admin_port %>

# Guardian mesh hidden service
HiddenServiceDir <%= @guardian_dir %>
HiddenServicePort 8443 127.0.0.1:<%= @mesh_port %>
